[Unit]
Description=CapsuleCorpOS - DESTINY Service
After=network.target
PartOf=capsulecorp.target

[Service]
Type=simple
ExecStart=/opt/capsulecorp/terminal/ccos-destiny.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccos-destiny

[Install]
WantedBy=multi-user.target
