[Unit]
Description=CapsuleCorpOS - AUDIOAI Service
After=network.target
PartOf=capsulecorp.target

[Service]
Type=simple
ExecStart=/opt/capsulecorp/terminal/ccos-audioai.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccos-audioai

[Install]
WantedBy=multi-user.target
