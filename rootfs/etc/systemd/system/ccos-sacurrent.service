[Unit]
Description=CapsuleCorpOS - SACURRENT Service
After=network.target
PartOf=capsulecorp.target

[Service]
Type=simple
ExecStart=/opt/capsulecorp/terminal/ccos-sacurrent.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccos-sacurrent

[Install]
WantedBy=multi-user.target
